# Bitcoin Daily VIP — api-server environment template. Copy to .env and fill in.
NODE_ENV=development
PORT=8084
LOG_LEVEL=info
REPLIT_DOMAINS=localhost:8083

# Clerk (auth) — required
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
ADMIN_CLERK_USER_ID=user_...

# Postgres — required to boot
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# In-portal AI support chat
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# Homepage live trade stats
TRADRX_API_KEY=

# Cron endpoint protection
CRON_SECRET=

# Stripe (checkout/subscriptions) — USE TEST KEYS ONLY
BDV_STRIPE_API_KEY=sk_test_...
STRIPE_VIP_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Discord OAuth + VIP role assignment
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VIP_ROLE_ID=
DISCORD_REDIRECT_URI=http://localhost:8083/api/discord/callback

# Resend (transactional email)
RESEND_API_KEY=re_...
